{
  "name": "jianghu-engine",
  "private": true,
  "version": "0.22.6-ea",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "VITE_BASE=/jianghu-life2/ npm run build",
    "build:mobile": "VITE_BASE=/ npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:narrate": "node scripts/auditNarrate.mjs --fail",
    "docs:events": "vite-node scripts/dumpEvents.mts && vite-node scripts/buildEventsPage.mts",
    "audit:events": "vite-node scripts/auditEventDraws.mts"
  },
  "dependencies": {
    "immer": "^11.1.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
