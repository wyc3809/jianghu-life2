{
  "name": "jianghu-engine",
  "private": true,
  "version": "0.97.2-ea",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:online": "node scripts/devOnline.mjs",
    "build": "tsc --noEmit && vite build",
    "build:pages": "VITE_BASE=/jianghu-life2/ npm run build",
    "build:mobile": "VITE_BASE=/ npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:copy": "node scripts/auditPlayerCopy.mjs",
    "audit:narrate": "node scripts/auditNarrate.mjs --fail",
    "docs:events": "vite-node scripts/dumpEvents.mts && vite-node scripts/buildEventsPage.mts",
    "audit:events": "vite-node scripts/auditEventDraws.mts",
    "ios:sync": "npm run build:mobile && cap sync ios && node scripts/ios/configure.mjs",
    "ios:open": "cap open ios",
    "ios:verify": "node scripts/ios/verify-package.mjs",
    "ios:package": "npm run ios:sync && npm run ios:verify && python3 scripts/ios/package_source.py",
    "ios:release-check": "node scripts/ios/release-check.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@supabase/supabase-js": "^2.117.2",
    "animejs": "^4.5.0",
    "gsap": "^3.15.0",
    "immer": "^11.1.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
